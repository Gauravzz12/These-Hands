# keystore.properties (Kept private, ignored by git)
# To sign your release .aab bundle automatically:
# 1. Rename or copy this file to 'keystore.properties' (in this root directory)
# 2. Fill in your keystore password below:

storeFile=../release.keystore
storePassword=YOUR_PASSWORD_HERE
keyAlias=TheseHands
keyPassword=YOUR_PASSWORD_HERE

